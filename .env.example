# Better Auth
# Gere um secret forte (ex.: openssl rand -base64 32)
BETTER_AUTH_SECRET=coloque-um-secret-forte-aqui

# URL pública usada pelo better-auth para setar cookies
# Em produção (Vercel), preencha com https://SEU-DOMINIO.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# URL exposta ao cliente (auth-client). Vazio usa o origin atual.
NEXT_PUBLIC_BETTER_AUTH_URL=

# Banco Postgres (Neon / Vercel Postgres / local)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Vercel Blob (para os prints das operações)
BLOB_READ_WRITE_TOKEN=
